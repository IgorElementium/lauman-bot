{
  "name": "lauman-bot",
  "version": "0.1.0",
  "description": "Conversational Telegram assistant for Jorn Lauman",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "db:init": "node --loader ts-node/esm scripts/init-db.ts"
